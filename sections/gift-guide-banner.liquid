{{ 'gift-guide-banner.css' | asset_url | stylesheet_tag }}

{%- comment -%} Load the chosen font in the weights this section uses. {%- endcomment -%}
{% style %}
  {{ section.settings.section_font | font_face: font_display: 'swap' }}
  {{ section.settings.section_font | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}
  {{ section.settings.section_font | font_modify: 'weight', '600' | font_face: font_display: 'swap' }}
{% endstyle %}

<section
  class="gg-banner"
  style="
    --gg-yellow: {{ section.settings.accent_color }};
    --gg-banner-font: {{ section.settings.section_font.family }}, {{ section.settings.section_font.fallback_families }};
  "
>
    {%- if section.settings.show_topbar -%}
    <div class="gg-banner__topbar">
        <p class="gg-banner__logo">{{section.settings.logo_text | escape}} </p>
        <p class="gg-banner__topbar-text">{{section.settings.topbar_text | escape}}</p>

        {%- if section.settings.topbar_button_label != blank -%}
            <a class="gg-banner__topbar-cta" href="{{section.settings.topbar_button_link | default: '#'}}">
                {{section.settings.topbar_button_label |escape}}
                <span class="gg-banner__arrow" aria-hidden="true">&#10230;</span>
            </a>
        {%- endif -%}
        </div>
    {%- endif -%}

    <div class="gg-banner__hero">
        {%- if section.settings.background_image != blank -%}
            <div class="gg-banner__media">
                {{
                    section.settings.background_image
                    | image_url: width: 2400
                    | image_tag:
                        class: 'gg-banner__bg',
                        loading: 'eager',
                        fetchpriority: 'high',
                        sizes: '100vw',
                        widths: '600, 900, 1200, 1800, 2400',
                        alt: ''
                }}
            </div>
        {%- endif -%}

        <div class="gg-banner__content">
            <h1 class="gg-banner__heading">{{ section.settings.heading | escape }}</h1>

            {%- if section.settings.subheading != blank -%}
                <p class="gg-banner__subheading gg-banner__subheading--desktop">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}

            {%- if section.settings.subheading_mobile != blank -%}
                <p class="gg-banner__subheading gg-banner__subheading--mobile">{{ section.settings.subheading_mobile | escape }}</p>
            {%- endif -%}

            {%- if section.settings.button_label != blank -%}
                <a class="gg-banner__cta" href="{{ section.settings.button_link | default: '#' }}">
                    {{ section.settings.button_label | escape }}
                    <span class="gg-banner__arrow" aria-hidden="true">&#10230;</span>
                </a>
            {%- endif -%}
        </div>
    </div>

    {%- if section.settings.strip_text != blank -%}
        <p class="gg-banner__strip gg-banner__strip--desktop">{{ section.settings.strip_text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.strip_text_mobile != blank -%}
        <p class="gg-banner__strip gg-banner__strip--mobile">{{ section.settings.strip_text_mobile | escape }}</p>
    {%- endif -%}
</section>

{% schema %}
{
  "name": "Gift Guide Banner",
  "tag": "section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background artwork"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "textarea",
      "id": "subheading_mobile",
      "label": "Subheading (mobile)",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Strapline",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "strip_text_mobile",
      "label": "Strapline (mobile)",
      "default": "SUSTAINABLE, ETHICALLY MADE ACTIVEWEAR"
    },
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Show top bar",
      "default": true
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "topbar_text",
      "label": "Top bar text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "topbar_button_label",
      "label": "Top bar button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "topbar_button_link",
      "label": "Top bar button link"
    },
    {
      "type": "font_picker",
      "id": "section_font",
      "label": "Section font",
      "default": "poppins_n4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#f5e31f"
    }
  ],
  "presets": [{ "name": "Gift Guide Banner" }]
}
{% endschema %}
