{{'gift-guide-grid.css' | asset_url | stylesheet_tag}}

{% style %}
    {{section.settings.section_font | font_face: font_display: 'swap'}}
{% endstyle %}

<section
    class="gg-grid"
    data-currency="{{ cart.currency.iso_code }}"
    style="--gg-grid-font: {{section.settings.section_font.family}}, {{section.settings.section_font.fallback_families}};"
>

    <h2 class="gg-grid__heading">{{ section.settings.heading | escape}}</h2>

    <ul class="gg-grid__list" role="list">
        {%- for block in section.blocks -%}
            {%- assign item = block.settings.product -%}

            {%- if item!=blank -%}
                <li class="gg-grid__item" {{ block.shopify_attributes }}>
                    {{
                        item.featured_image
                        | image_url: width: 1200
                        | image_tag: 
                            class: 'gg-grid__image',
                            loading:'lazy',
                            sizes: '(min-width: 750px) 33vw, 50vw',
                            widths: '300,500,900,1200',
                            alt: item.title
                    }}

                    <button
                        class="gg-grid__hotspot"
                        type="button"
                        style="--gg-hotspot-x: {{block.settings.hotspot_x}}%; --gg-hotspot-y: {{block.settings.hotspot_y}}%;"
                        aria-label="Quick view: {{item.title | escape}}"
                        data-product-handle="{{item.handle}}"
                    >
                        <span aria-hidden="true">+</span>

                    </button>

                    {%- comment -%} Only the fields the popup needs, rather than the whole product. {%- endcomment -%}
                    <script type="application/json" data-gg-product="{{ item.handle }}">
                        {
                            "title": {{ item.title | json }},
                            "handle": {{ item.handle | json }},
                            "description": {{ item.description | json }},
                            "featured_image": {{ item.featured_image | image_url: width: 400 | json }},
                            "price": {{ item.price | json }},
                            "options": {{ item.options | json }},
                            "variants": [
                                {%- for variant in item.variants -%}
                                    {
                                        "id": {{ variant.id | json }},
                                        "available": {{ variant.available | json }},
                                        "price": {{ variant.price | json }},
                                        "options": {{ variant.options | json }}
                                    }{%- unless forloop.last -%},{%- endunless -%}
                                {%- endfor -%}
                            ]
                        }
                    </script>
                </li>
            {%- endif -%}
        {%- endfor -%}
    </ul>

    <div class="gg-popup" data-gg-popup hidden>
        <div class="gg-popup__backdrop" data-gg-close></div>
        <div class="gg-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="gg-popup-title-{{section.id}}">
            <button class="gg-popup__close" type="button" data-gg-close aria-label="Close">&times;</button>

            <div class="gg-popup__head">
                <img class="gg-popup__image" src="" alt="" width="88" height="110">
                <div>
                    <h3 class="gg-popup__title" id="gg-popup-title-{{section.id}}"></h3>
                    <p class="gg-popup__price"></p>
                </div>
            </div>

            <div class="gg-popup__description"></div>
            <form class="gg-popup__form" data-gg-form>
                <div class="gg-popup__options" data-gg-options></div>
                <button class="gg-popup__submit" type="submit">
                    ADD TO CART
                    <span aria-hidden="true">&#10230;</span>
                </button>

                <p class="gg-popup__message" role="status" data-gg-message></p>
            </form>
        </div>
    </div>
    <script src="{{ 'gift-guide-grid.js' | asset_url }}" defer></script>
</section>

{%  schema %}
{
    "name": "Gift Guide Grid",
    "tag": "section",
    "enabled_on": {"templates": ["page"]},
    "max_blocks":6,
    "settings":[
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default":"Tisso vison in the wild"
        },
        {
            "type": "font_picker",
            "id":"section_font",
            "label": "Section font",
            "default": "poppins_n4"
        }
    ],
    "blocks":[
        {
            "type": "product",
            "name": "Product",
            "settings": [
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                },
                {
                    "type":"range",
                    "id": "hotspot_x",
                    "label": "Marker position X",
                    "min": 0,
                    "max": 100,
                    "step":1,
                    "unit": "%",
                    "default":50
                },
                {
                    "type":"range",
                    "id": "hotspot_y",
                    "label": "Marker position Y",
                    "min": 0,
                    "max": 100,
                    "step":1,
                    "unit": "%",
                    "default":50
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Gift Guide Grid",
            "blocks":[
                {"type":"product"},{"type":"product"},{"type":"product"},
                {"type":"product"},{"type":"product"},{"type":"product"}

            ]
        }
    ]
}

{% endschema %}